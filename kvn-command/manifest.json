{
  "id": "com.kvn.command",
  "name": "KVN Command",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "kvn.command.panel",
      "label": {
        "default": "KVN Command"
      },
      "minimumSize": { "width": 360, "height": 420 },
      "maximumSize": { "width": 900, "height": 1200 },
      "preferredDockedSize": { "width": 420, "height": 560 },
      "preferredFloatingSize": { "width": 420, "height": 560 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["chrome"]
    }
  ]
}
