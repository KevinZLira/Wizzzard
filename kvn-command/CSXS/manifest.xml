<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.kvn.command" ExtensionBundleVersion="0.3.5" ExtensionBundleName="KVN Console" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.kvn.command.main" Version="0.3.5" />
    <Extension Id="com.kvn.command.bg" Version="0.3.5" />
    <Extension Id="com.kvn.command.shortcuts" Version="0.3.5" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.kvn.command.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/main/index.html</MainPath>
          <ScriptPath>./host/ppro.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Menu>KVN Console</Menu>
          <Geometry>
            <Size>
              <Width>520</Width>
              <Height>56</Height>
            </Size>
            <MinSize>
              <Width>420</Width>
              <Height>56</Height>
            </MinSize>
            <MaxSize>
              <Width>640</Width>
              <Height>560</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/plugin-icon.png</Icon>
            <Icon Type="RollOver">./icons/plugin-icon.png</Icon>
            <Icon Type="Disabled">./icons/plugin-icon.png</Icon>
            <Icon Type="DarkNormal">./icons/dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.kvn.command.bg">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/bg/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
            <Event>com.adobe.csxs.events.AppOnline</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Width>200</Width>
              <Height>80</Height>
            </Size>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/plugin-icon.png</Icon>
            <Icon Type="RollOver">./icons/plugin-icon.png</Icon>
            <Icon Type="Disabled">./icons/plugin-icon.png</Icon>
            <Icon Type="DarkNormal">./icons/dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.kvn.command.shortcuts">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/shortcuts/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Menu>KVN Console - Atalhos</Menu>
          <Geometry>
            <Size>
              <Width>600</Width>
              <Height>430</Height>
            </Size>
            <MinSize>
              <Width>560</Width>
              <Height>400</Height>
            </MinSize>
            <MaxSize>
              <Width>640</Width>
              <Height>560</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/plugin-icon.png</Icon>
            <Icon Type="RollOver">./icons/plugin-icon.png</Icon>
            <Icon Type="Disabled">./icons/plugin-icon.png</Icon>
            <Icon Type="DarkNormal">./icons/dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>