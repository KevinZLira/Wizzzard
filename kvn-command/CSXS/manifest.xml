<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.kvn.command" ExtensionBundleVersion="0.2.0" ExtensionBundleName="KVN Command"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.kvn.command.main" Version="0.2.0"/>
        <Extension Id="com.kvn.command.bg" Version="0.2.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- CEP is still fully supported alongside UXP in current
                 Premiere Pro releases; this is the architecture confirmed
                 working end-to-end by real signed third-party extensions. -->
            <Host Name="PPRO" Version="[14.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.kvn.command.main">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/main/index.html</MainPath>
                    <ScriptPath>./host/ppro.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Custom</Type>
                    <Menu>KVN Command</Menu>
                    <!-- Starts as just the search row — Spotlight-style —
                         and grows via resizeContent() as results appear.
                         resizeContent() is confirmed supported for
                         Custom/modeless CEP windows in Premiere Pro (the
                         restriction that applies is specific to the
                         "Panel" UI type, not this one). -->
                    <Geometry>
                        <Size>
                            <Width>520</Width>
                            <Height>56</Height>
                        </Size>
                        <MinSize>
                            <Width>420</Width>
                            <Height>56</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>640</Width>
                            <Height>560</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/plugin-icon.png</Icon>
                        <Icon Type="RollOver">./icons/plugin-icon.png</Icon>
                        <Icon Type="Disabled">./icons/plugin-icon.png</Icon>
                        <Icon Type="DarkNormal">./icons/dark.png</Icon>
                        <Icon Type="DarkRollOver">./icons/dark.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>

        <!-- Invisible companion extension: hosts a local HTTP server
             (client/bg/app.js) so an OS-level global hotkey (via
             AutoHotkey on Windows, an Automator Quick Action on macOS)
             can tell this extension to open/focus the real KVN Command
             window above, via window.__adobe_cep__.requestOpenExtension().
             See README "Opening the window" for setup. -->
        <Extension Id="com.kvn.command.bg">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/bg/index.html</MainPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Custom</Type>
                    <Geometry>
                        <Size>
                            <Width>10</Width>
                            <Height>10</Height>
                        </Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
